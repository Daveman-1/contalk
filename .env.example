# ─── ConTalk Environment Variables ──────────────────────────────────────

# Google reCAPTCHA v2 (Get free keys at: https://www.google.com/recaptcha/admin)
# Choose "reCAPTCHA v2" -> "I'm not a robot" Checkbox
# Leave blank to use Google's official developer test key on localhost
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ─── Database & Auth (Optional for cloud, defaults to local JSON) ───────
# JWT Secret for user authentication tokens
JWT_SECRET=

# Upstash Redis REST API (Optional: used for cloud multi-instance hosting)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Giphy API Key (Optional: for GIF picker)
# GIPHY_API_KEY=
